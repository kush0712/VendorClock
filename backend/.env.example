# =============================================================================
# VendorClock Backend — Environment Configuration
# Copy this to .env and fill in real values before running
# =============================================================================

# ------ Application ------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000

# ------ Database (PostgreSQL) ------
DATABASE_URL=postgresql://vendorclock:vendorclock@localhost:5432/vendorclock

# ------ Redis (Celery broker + result backend) ------
REDIS_URL=redis://localhost:6379/0

# ------ LLM — Invoice OCR extraction ------
# Groq is PRIMARY (no training on submitted data — safe for real PAN/GSTIN)
GROQ_API_KEY=your-groq-api-key-here

# Gemini is FALLBACK ONLY — NEVER send real vendor data (PAN/GSTIN/amounts)
# Reserved for non-sensitive / test traffic only (Gemini free tier trains on prompts)
GEMINI_API_KEY=your-gemini-api-key-here

# ------ Email (internal alerts — NEVER vendor-facing) ------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=VendorClock
ALERT_DEFAULT_RECIPIENT=cfo@yourcompany.com

# ------ Slack (internal alerts) ------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ------ Statutory Rates ------
# RBI Bank Rate — update when RBI changes it (currently 6.50% as of mid-2026)
# Interest penalty = 3x this rate, compounding monthly
RBI_BANK_RATE_PERCENT=6.50

# ------ CA Confirmation Flags (do NOT change without CA/lawyer sign-off) ------
# Whether GST is included in the taxable base for disallowance calculation.
# Defaulting to False (GST excluded) — pending CA confirmation.
GST_INCLUDED_IN_TAXABLE_BASE=false

# Dispute clock reset trigger — pending CA/lawyer confirmation of exact legal trigger.
# Options: "objection_raised" | "dispute_resolved"
# Until confirmed, the clock simply pauses on objection date.
DISPUTE_CLOCK_RESET_TRIGGER=objection_raised

# ------ Inbound Invoice Email (Gmail API — Phase 2, not active in MVP) ------
# GMAIL_CREDENTIALS_JSON=path/to/credentials.json
# GMAIL_TOKEN_JSON=path/to/token.json
# INVOICE_INBOX_ADDRESS=invoices@yourcompany.com
