# =============================================================================
# VendorClock — Root .gitignore
# =============================================================================

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Backend — Secrets & Environment ───────────────────────────────────────────
backend/.env
# .env.example is safe to commit (no real values)
# DO NOT add backend/.env.example here

# ── Backend — Database files ───────────────────────────────────────────────────
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# ── Backend — Python artifacts ─────────────────────────────────────────────────
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/.pytest_cache/
backend/**/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/dist/
backend/build/
backend/*.egg-info/

# ── Backend — Uploads & runtime data ──────────────────────────────────────────
backend/uploads/
# Keep the uploads directory but not its contents
!backend/uploads/.gitkeep

# ── Backend — Celery / Redis state ────────────────────────────────────────────
backend/celerybeat-schedule
backend/celerybeat.pid

# ── Backend — Alembic generated env (contains DB URL) ─────────────────────────
# alembic.ini is safe; alembic/env.py is safe — both committed
# Only exclude if you have local overrides

# ── Frontend — already handled by frontend/.gitignore ─────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel/

# ── Test data / sample files (real purchase register data) ───────────────────
test_comprehensive.csv
test_purchase_register.csv
*.xlsx
# Exception: keep the dev spec and README
!VendorClock_Dev_Spec.md
!README.md

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
